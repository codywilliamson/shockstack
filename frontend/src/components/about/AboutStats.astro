---
import StatsCard from "../content/StatsCard.astro";
---

<!-- stats -->
<section class="reveal px-4 py-12 md:py-16">
  <div class="mx-auto max-w-5xl">
    <div class="stagger-in grid grid-cols-2 gap-6 md:grid-cols-4">
      <StatsCard value="14" label="Built-in themes" gradient="purple-pink" />
      <StatsCard value="50+" label="Components" gradient="cyan-green" />
      <StatsCard value="0" label="JS animation deps" gradient="orange-yellow" />
      <StatsCard value="MIT" label="License" gradient="pink-orange" />
    </div>
  </div>
</section>
