---
import Badge from "../content/Badge.astro";
---

<section
  class="gradient-bg-mesh relative overflow-hidden px-4 pt-20 pb-12 md:pt-28 md:pb-16"
>
  <div class="relative mx-auto max-w-4xl text-center">
    <div class="fade-in mb-4 flex justify-center">
      <Badge color="purple" variant="subtle">Open source • MIT</Badge>
    </div>
    <h1 class="fade-in mb-5 text-4xl leading-tight font-extrabold md:text-6xl">
      Pricing that <span class="gradient-text-purple-pink">scales with you</span
      >
    </h1>
    <p class="fade-in text-fg-secondary mx-auto max-w-2xl text-base md:text-lg">
      Free forever for personal projects. Affordable for teams shipping
      production apps. Custom for organizations at scale.
    </p>
  </div>
</section>
