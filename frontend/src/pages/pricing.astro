---
import BaseLayout from "../layouts/BaseLayout.astro";
import DemoBanner from "../components/content/DemoBanner.astro";
import PricingHero from "../components/pricing/PricingHero.astro";
import PricingTiers from "../components/pricing/PricingTiers.astro";
import ComparisonGrid from "../components/pricing/ComparisonGrid.astro";
import PricingFaq from "../components/pricing/PricingFaq.astro";

export const prerender = true;
---

<BaseLayout
  title="Pricing — ShockStack"
  description="Simple, transparent pricing for ShockStack. Free forever for personal projects, affordable for teams."
  fullWidth
>
  <DemoBanner
    label="Demo page"
    message="Pricing tiers are examples for template showcase. Real ShockStack is MIT-licensed and free."
    href="/components"
    ctaLabel="View components"
  />
  <PricingHero />
  <PricingTiers />
  <ComparisonGrid />
  <PricingFaq />
</BaseLayout>
