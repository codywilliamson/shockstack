---
import BaseLayout from "../layouts/BaseLayout.astro";
import PricingCard from "../components/content/PricingCard.astro";
import Badge from "../components/content/Badge.astro";
import AccordionPanel from "../components/ui/AccordionPanel.vue";
import DemoBanner from "../components/content/DemoBanner.astro";

export const prerender = true;

const billingFaq = [
  {
    value: "b1",
    title: "Can I switch plans later?",
    content:
      "Yes — upgrades take effect immediately, downgrades at the end of the current billing cycle. No fees, no hoops.",
  },
  {
    value: "b2",
    title: "Do you offer student or OSS discounts?",
    content:
      "Yes. Open-source maintainers and students get Pro features free — reach out with a link to your GitHub profile or a valid student email.",
  },
  {
    value: "b3",
    title: "What happens if I cancel?",
    content:
      "You keep access through the end of the period you paid for. After that you're back on Starter — your data and themes stay intact.",
  },
  {
    value: "b4",
    title: "Is there a yearly discount?",
    content:
      "Pro is 20% off when billed yearly. Enterprise pricing is always custom and can be quarterly or annual.",
  },
];
---

<BaseLayout
  title="Pricing — ShockStack"
  description="Simple, transparent pricing for ShockStack. Free forever for personal projects, affordable for teams."
  fullWidth
>
  <DemoBanner
    label="Demo page"
    message="Pricing tiers are examples for template showcase. Real ShockStack is MIT-licensed and free."
    href="/components"
    ctaLabel="View components"
  />

  <!-- hero -->
  <section
    class="gradient-bg-mesh relative overflow-hidden px-4 pt-20 pb-12 md:pt-28 md:pb-16"
  >
    <div class="relative mx-auto max-w-4xl text-center">
      <div class="fade-in mb-4 flex justify-center">
        <Badge color="purple" variant="subtle">Open source • MIT</Badge>
      </div>
      <h1
        class="fade-in mb-5 text-4xl leading-tight font-extrabold md:text-6xl"
      >
        Pricing that <span class="gradient-text-purple-pink"
          >scales with you</span
        >
      </h1>
      <p
        class="fade-in text-fg-secondary mx-auto max-w-2xl text-base md:text-lg"
      >
        Free forever for personal projects. Affordable for teams shipping
        production apps. Custom for organizations at scale.
      </p>
    </div>
  </section>

  <!-- pricing tiers -->
  <section class="reveal gradient-bg-subtle px-4 pt-4 pb-20 md:pb-28">
    <div class="mx-auto max-w-5xl">
      <div class="stagger-in grid gap-6 md:grid-cols-3">
        <PricingCard
          name="Starter"
          price="Free"
          description="For personal projects and learning"
          features={[
            "Full monorepo template",
            "All 14 themes",
            "Community support",
            "MIT license",
            "Unlimited self-hosting",
          ]}
          cta="Get Started"
          href="/docs"
        />
        <PricingCard
          name="Pro"
          price="$29"
          description="For teams shipping production apps"
          features={[
            "Everything in Starter",
            "Priority support",
            "Private Discord access",
            "Early access to updates",
            "Custom theme builder",
            "Monthly office hours",
          ]}
          cta="Start Free Trial"
          href="/register"
          featured
        />
        <PricingCard
          name="Enterprise"
          price="Custom"
          description="For organizations at scale"
          features={[
            "Everything in Pro",
            "Dedicated support engineer",
            "Custom integrations",
            "SLA guarantee",
            "Team onboarding session",
            "Annual architecture review",
          ]}
          cta="Contact Sales"
          href="/docs"
        />
      </div>

      <p class="text-fg-muted mt-10 text-center text-sm">
        All plans include the full source. ShockStack stays open — paid tiers
        support the project and unlock convenience features.
      </p>
    </div>
  </section>

  <!-- comparison grid -->
  <section class="reveal px-4 py-20 md:py-28">
    <div class="mx-auto max-w-5xl">
      <div class="mb-10 text-center">
        <p
          class="text-accent-cyan mb-2 font-mono text-xs tracking-wider uppercase"
        >
          compare
        </p>
        <h2 class="mb-3 text-3xl font-bold md:text-4xl">
          What's in <span class="gradient-text-cyan-green">each tier</span>
        </h2>
      </div>

      <div class="compare-grid">
        <div class="compare-row compare-head">
          <span>Feature</span>
          <span>Starter</span>
          <span class="compare-head-featured">Pro</span>
          <span>Enterprise</span>
        </div>
        <div class="compare-row">
          <span>Full source access</span>
          <Badge color="green" size="sm">Yes</Badge>
          <Badge color="green" size="sm">Yes</Badge>
          <Badge color="green" size="sm">Yes</Badge>
        </div>
        <div class="compare-row">
          <span>All 14 themes</span>
          <Badge color="green" size="sm">Yes</Badge>
          <Badge color="green" size="sm">Yes</Badge>
          <Badge color="green" size="sm">Yes</Badge>
        </div>
        <div class="compare-row">
          <span>Community support</span>
          <Badge color="green" size="sm">Yes</Badge>
          <Badge color="green" size="sm">Yes</Badge>
          <Badge color="green" size="sm">Yes</Badge>
        </div>
        <div class="compare-row">
          <span>Priority support</span>
          <Badge color="neutral" size="sm">—</Badge>
          <Badge color="green" size="sm">Yes</Badge>
          <Badge color="green" size="sm">Yes</Badge>
        </div>
        <div class="compare-row">
          <span>Custom theme builder</span>
          <Badge color="neutral" size="sm">—</Badge>
          <Badge color="green" size="sm">Yes</Badge>
          <Badge color="green" size="sm">Yes</Badge>
        </div>
        <div class="compare-row">
          <span>Dedicated engineer</span>
          <Badge color="neutral" size="sm">—</Badge>
          <Badge color="neutral" size="sm">—</Badge>
          <Badge color="green" size="sm">Yes</Badge>
        </div>
        <div class="compare-row">
          <span>SLA guarantee</span>
          <Badge color="neutral" size="sm">—</Badge>
          <Badge color="neutral" size="sm">—</Badge>
          <Badge color="green" size="sm">99.9%</Badge>
        </div>
      </div>
    </div>
  </section>

  <!-- faq -->
  <section class="reveal gradient-bg-radial px-4 py-20 md:py-28">
    <div class="mx-auto max-w-3xl">
      <div class="mb-10 text-center">
        <p
          class="text-accent-orange mb-2 font-mono text-xs tracking-wider uppercase"
        >
          billing faq
        </p>
        <h2 class="mb-3 text-3xl font-bold md:text-4xl">
          Common <span class="gradient-text-orange-yellow">questions</span>
        </h2>
      </div>

      <AccordionPanel client:load items={billingFaq} />

      <p class="text-fg-muted mt-8 text-center text-sm">
        Still have questions? <a
          href="/docs"
          class="text-accent-purple hover:text-accent-pink">Read the docs</a
        > or
        <a
          href="mailto:hello@shockstack.dev"
          class="text-accent-purple hover:text-accent-pink">email us</a
        >.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .compare-grid {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-xl);
    overflow: hidden;
    background-color: var(--color-bg-secondary);
  }

  .compare-row {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 0.5rem;
    align-items: center;
    padding: 0.875rem 1.25rem;
    font-size: 0.875rem;
    color: var(--color-fg-secondary);
  }

  .compare-row + .compare-row {
    border-top: 1px solid var(--color-border-muted);
  }

  .compare-head {
    background-color: var(--color-bg-tertiary);
    color: var(--color-fg-primary);
    font-weight: 600;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .compare-head-featured {
    color: var(--color-accent-purple);
  }

  @media (max-width: 640px) {
    .compare-row {
      grid-template-columns: 1.25fr 0.75fr 0.75fr 0.75fr;
      padding: 0.75rem 0.875rem;
      font-size: 0.8125rem;
      gap: 0.375rem;
    }
  }
</style>
