---
import TerminalTabs from "../content/TerminalTabs.astro";

type TerminalLineKind = "command" | "output" | "success";

interface TerminalLine {
  kind: TerminalLineKind;
  text: string;
}

interface TerminalVariant {
  lines: TerminalLine[];
}

const stats = [
  { label: "Frontend", value: "Astro 5 + Vue 3" },
  { label: "Theme engine", value: "14 token palettes" },
  { label: "Backend lane", value: ".NET 10 optional" },
];

const bootSequence: Record<"linux" | "mac" | "windows", TerminalVariant> = {
  linux: {
    lines: [
      {
        kind: "command",
        text: "git clone https://github.com/codywilliamson/shockstack my-app",
      },
      { kind: "command", text: "cd my-app && pnpm install" },
      {
        kind: "command",
        text: "dotnet run --project backend/src/ShockStack.AppHost",
      },
      { kind: "output", text: "-> postgres running on port 5432" },
      { kind: "output", text: "-> api ready on https://localhost:7275" },
      { kind: "output", text: "-> frontend ready on http://localhost:4321" },
      {
        kind: "success",
        text: "check aspire dashboard on http://localhost:15888",
      },
    ],
  },
  mac: {
    lines: [
      {
        kind: "command",
        text: "git clone https://github.com/codywilliamson/shockstack my-app",
      },
      { kind: "command", text: "cd my-app && pnpm install" },
      {
        kind: "command",
        text: "dotnet run --project backend/src/ShockStack.AppHost",
      },
      { kind: "output", text: "-> postgres running on port 5432" },
      { kind: "output", text: "-> api ready on https://localhost:7275" },
      { kind: "output", text: "-> frontend ready on http://localhost:4321" },
      {
        kind: "success",
        text: "check aspire dashboard on http://localhost:15888",
      },
    ],
  },
  windows: {
    lines: [
      {
        kind: "command",
        text: "git clone https://github.com/codywilliamson/shockstack my-app",
      },
      { kind: "command", text: "cd my-app; pnpm install" },
      {
        kind: "command",
        text: "dotnet run --project backend\\src\\ShockStack.AppHost",
      },
      { kind: "output", text: "-> postgres running on port 5432" },
      { kind: "output", text: "-> api ready on https://localhost:7275" },
      { kind: "output", text: "-> frontend ready on http://localhost:4321" },
      {
        kind: "success",
        text: "check aspire dashboard on http://localhost:15888",
      },
    ],
  },
};
---

<section class="launchpad-hero">
  <div class="launchpad-hero__halo" aria-hidden="true"></div>
  <div class="launchpad-hero__grid" aria-hidden="true"></div>

  <div class="launchpad-hero__copy">
    <p class="launchpad-hero__eyebrow">
      <span class="launchpad-hero__dot pulse-soft"></span>
      shockstack v1 / convention-first monorepo
    </p>

    <h1 class="launchpad-hero__title">
      Build full-stack apps
      <span class="gradient-text-animated">at lightning speed</span>
    </h1>

    <p class="launchpad-hero__body">
      Astro 5 SSR, Vue 3 islands, Tailwind 4, design tokens, Better Auth, and an
      optional .NET 10 backend all arrive pre-wired so the first useful commit
      comes fast.
    </p>

    <div class="launchpad-hero__actions">
      <a href="/docs" class="launchpad-hero__primary">Get Started</a>
      <a
        href="https://github.com/codywilliamson/shockstack"
        target="_blank"
        rel="noopener noreferrer"
        class="launchpad-hero__secondary"
      >
        View on GitHub
      </a>
    </div>

    <dl class="launchpad-hero__stats">
      {
        stats.map((stat) => (
          <div class="launchpad-hero__stat">
            <dt>{stat.label}</dt>
            <dd>{stat.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <div class="launchpad-hero__terminal">
    <TerminalTabs title="Boot Sequence" variants={bootSequence} />
  </div>
</section>

<style>
  .launchpad-hero {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-2xl);
    border: 1px solid
      color-mix(in srgb, var(--color-border-default) 88%, transparent);
    background:
      radial-gradient(
        circle at 50% 0%,
        color-mix(in srgb, var(--color-accent-cyan) 18%, transparent),
        transparent 42%
      ),
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--color-bg-secondary) 94%, transparent),
        color-mix(in srgb, var(--color-bg-primary) 98%, transparent)
      );
    padding: clamp(1.5rem, 2vw + 1rem, 2.5rem);
    box-shadow: 0 32px 80px -56px rgba(0, 0, 0, 0.6);
  }

  .launchpad-hero__halo {
    position: absolute;
    inset: -25% 10% auto;
    height: 18rem;
    background: radial-gradient(
      ellipse at center,
      color-mix(in srgb, var(--color-accent-purple) 24%, transparent),
      color-mix(in srgb, var(--color-accent-pink) 10%, transparent) 48%,
      transparent 72%
    );
    filter: blur(56px);
    pointer-events: none;
  }

  .launchpad-hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(
        color-mix(in srgb, var(--color-border-muted) 30%, transparent) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        color-mix(in srgb, var(--color-border-muted) 30%, transparent) 1px,
        transparent 1px
      );
    background-size: 2.5rem 2.5rem;
    mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.35), transparent 82%);
    opacity: 0.45;
    pointer-events: none;
  }

  .launchpad-hero__copy {
    position: relative;
    z-index: 1;
    margin: 0 auto;
    max-width: 54rem;
    text-align: center;
  }

  .launchpad-hero__eyebrow {
    margin: 0 0 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    border-radius: var(--radius-full);
    border: 1px solid
      color-mix(in srgb, var(--color-accent-green) 32%, transparent);
    background: color-mix(in srgb, var(--color-bg-primary) 72%, transparent);
    padding: 0.45rem 0.8rem;
    color: var(--color-accent-green);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .launchpad-hero__dot {
    display: inline-block;
    height: 0.55rem;
    width: 0.55rem;
    border-radius: 999px;
    background: currentColor;
    box-shadow: 0 0 0 0.3rem color-mix(in srgb, currentColor 16%, transparent);
  }

  .launchpad-hero__title {
    margin: 0;
    font-size: clamp(2.85rem, 6vw, 5.2rem);
    line-height: 1.1;
    letter-spacing: -0.04em;
  }

  .launchpad-hero__title span {
    display: inline-block;
    padding-bottom: 0.2em;
    line-height: 1.15;
  }

  .launchpad-hero__body {
    margin: 1.25rem auto 0;
    max-width: 44rem;
    color: var(--color-fg-secondary);
    font-size: clamp(1rem, 1vw + 0.85rem, 1.25rem);
    line-height: 1.7;
  }

  .launchpad-hero__actions {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.9rem;
  }

  .launchpad-hero__primary,
  .launchpad-hero__secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 10rem;
    border-radius: var(--radius-lg);
    padding: 0.95rem 1.4rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.25s ease,
      background-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .launchpad-hero__primary {
    background: linear-gradient(
      135deg,
      var(--color-accent-cyan),
      var(--color-accent-purple)
    );
    color: var(--color-bg-primary);
    box-shadow: 0 18px 40px -20px
      color-mix(in srgb, var(--color-accent-cyan) 70%, transparent);
  }

  .launchpad-hero__secondary {
    border: 1px solid var(--color-border-default);
    background: color-mix(in srgb, var(--color-bg-secondary) 70%, transparent);
    color: var(--color-fg-primary);
  }

  .launchpad-hero__primary:hover,
  .launchpad-hero__secondary:hover {
    transform: translateY(-2px);
  }

  .launchpad-hero__secondary:hover {
    border-color: color-mix(
      in srgb,
      var(--color-accent-purple) 42%,
      var(--color-border-default)
    );
  }

  .launchpad-hero__stats {
    margin: 2rem auto 0;
    display: grid;
    max-width: 46rem;
    gap: 0.85rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .launchpad-hero__stat {
    border-radius: var(--radius-xl);
    border: 1px solid
      color-mix(in srgb, var(--color-border-default) 72%, transparent);
    background: color-mix(in srgb, var(--color-bg-primary) 72%, transparent);
    padding: 1rem 1.1rem;
  }

  .launchpad-hero__stat dt {
    color: var(--color-fg-muted);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .launchpad-hero__stat dd {
    margin: 0.45rem 0 0;
    font-size: 1rem;
    font-weight: 600;
  }

  .launchpad-hero__terminal {
    position: relative;
    z-index: 1;
    margin: 2.5rem auto 0;
    max-width: 48rem;
  }

  @media (max-width: 48rem) {
    .launchpad-hero__stats {
      grid-template-columns: 1fr;
    }
  }
</style>
