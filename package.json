{
  "name": "shockstack",
  "private": true,
  "type": "module",
  "bin": {
    "ss": "./bin/ss.ts"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test && vitest run --config bin/vitest.config.ts",
    "test:cli": "vitest run --config bin/vitest.config.ts",
    "typecheck": "turbo typecheck",
    "docs:check": "node scripts/check-docs-style.mjs",
    "tokens:build": "pnpm --filter @shockstack/tokens build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@google/design.md": "^0.1.1",
    "@inquirer/prompts": "^8.4.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "commander": "^14.0.3",
    "eslint": "^10.3.0",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-vue": "^10.9.0",
    "handlebars": "^4.7.9",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.2",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "semantic-release": "^25.0.3",
    "tsx": "^4.19.0",
    "turbo": "^2.9.8",
    "vitest": "^4.1.5",
    "vue-eslint-parser": "^10.4.0"
  },
  "packageManager": "pnpm@10.33.0",
  "lint-staged": {
    "*.{ts,tsx,vue,astro,js,cjs,mjs}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,vue,astro,js,cjs,mjs,json,css,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "yaml": ">=2.8.3",
      "vite": ">=7.3.2 <8",
      "smol-toml": ">=1.6.1",
      "picomatch": ">=4.0.4",
      "h3": ">=1.15.9 <2",
      "devalue": ">=5.6.4",
      "defu": ">=6.1.5"
    },
    "ignoredBuiltDependencies": [
      "@bundled-es-modules/glob",
      "esbuild",
      "sharp",
      "style-dictionary",
      "workerd"
    ]
  },
  "version": "1.20.0"
}
