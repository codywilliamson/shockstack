---
import Skeleton from "../content/Skeleton.astro";
---

<!-- skeleton loaders -->
<section class="reveal px-4 py-20 md:py-28">
  <div class="mx-auto max-w-6xl">
    <div class="mb-12">
      <p
        class="text-accent-purple mb-2 font-mono text-xs tracking-wider uppercase"
      >
        skeleton
      </p>
      <h2 class="mb-4 text-3xl font-bold md:text-4xl">
        Loading <span class="gradient-text-purple-pink">placeholders</span>
      </h2>
      <p class="text-fg-secondary max-w-2xl text-lg">
        Shimmer animation for content that hasn't loaded yet. Pulses instead
        when <code>prefers-reduced-motion</code> is set.
      </p>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      <div class="skeleton-demo">
        <code class="badge-row-label">profile card</code>
        <div class="skeleton-demo-body">
          <div class="skeleton-row">
            <Skeleton shape="circle" />
            <div class="skeleton-row-text">
              <Skeleton shape="text" width="8rem" />
              <Skeleton shape="text" width="5rem" height="0.6875rem" />
            </div>
          </div>
          <Skeleton shape="text" lines={3} />
        </div>
      </div>

      <div class="skeleton-demo">
        <code class="badge-row-label">media card</code>
        <div class="skeleton-demo-body">
          <Skeleton shape="rect" height="10rem" />
          <Skeleton shape="text" width="60%" height="1rem" />
          <Skeleton shape="text" lines={2} />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .badge-row-label {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-fg-muted);
    margin-bottom: 0.75rem;
    background-color: var(--color-bg-tertiary);
    padding: 0.125rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  .skeleton-demo {
    padding: 1.5rem;
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-xl);
    background-color: var(--color-bg-secondary);
  }

  .skeleton-demo-body {
    margin-top: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .skeleton-row {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }

  .skeleton-row-text {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }
</style>
