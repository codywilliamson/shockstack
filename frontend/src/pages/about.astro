---
import BaseLayout from "../layouts/BaseLayout.astro";
import Badge from "../components/content/Badge.astro";
import Avatar from "../components/content/Avatar.astro";
import StatsCard from "../components/content/StatsCard.astro";

export const prerender = true;

const timeline = [
  {
    date: "2024 Q3",
    title: "The idea",
    body: "Years of wiring up the same stack for every new project finally boiled over. A convention-first template was the fix.",
    color: "purple",
  },
  {
    date: "2025 Q1",
    title: "First prototype",
    body: "Astro + Vue + CF Workers on the frontend. .NET 10 with Aspire on the backend. Design tokens stitched through the whole tree.",
    color: "pink",
  },
  {
    date: "2025 Q3",
    title: "Design system lands",
    body: "14 themes, full token pipeline via Style Dictionary, and a component library that re-skins itself on a single attribute change.",
    color: "cyan",
  },
  {
    date: "2026 Q1",
    title: "Open-sourced",
    body: "Released under MIT on GitHub with a semantic-release pipeline and docs site. First outside contributions rolling in.",
    color: "green",
  },
  {
    date: "Today",
    title: "Shipping weekly",
    body: "Steady cadence of component, docs, and DX improvements driven by usage and community feedback.",
    color: "orange",
  },
] as const;

const team = [
  {
    name: "Cody Williamson",
    role: "Creator & maintainer",
    gradient: "purple-pink",
    bio: "Full-stack engineer. Built ShockStack to stop re-solving the same setup problem for every new project.",
  },
  {
    name: "Sarah Kim",
    role: "Frontend & design",
    gradient: "cyan-green",
    bio: "Design-systems specialist. Turns scattered decisions into cohesive token pipelines.",
  },
  {
    name: "Marcus Johnson",
    role: "Backend & infra",
    gradient: "orange-yellow",
    bio: ".NET + Aspire heavy lifting. Makes the cross-stack handshake feel obvious.",
  },
] as const;

const principles = [
  {
    title: "Conventions over configuration",
    body: "Opinions are a feature. A sensible default beats three good options you have to pick between.",
  },
  {
    title: "Tokens all the way down",
    body: "Every color, radius, and shadow routes through a single source. Themes are composable; overrides are rare.",
  },
  {
    title: "Zero-cost abstractions",
    body: "Shipping JS is a tradeoff. Astro islands + CSS animations mean the runtime footprint stays near zero.",
  },
  {
    title: "Optional depth",
    body: "The .NET backend is opt-in. The token pipeline is opt-in. Use what you need, delete the rest without regret.",
  },
];
---

<BaseLayout
  title="About — ShockStack"
  description="Why ShockStack exists, the team behind it, and the principles that guide every decision."
  fullWidth
>
  <!-- hero -->
  <section
    class="gradient-bg-mesh relative overflow-hidden px-4 pt-20 pb-16 md:pt-28 md:pb-24"
  >
    <div class="relative mx-auto max-w-4xl text-center">
      <div class="fade-in mb-4 flex justify-center">
        <Badge color="cyan" variant="subtle">Our story</Badge>
      </div>
      <h1
        class="fade-in mb-5 text-4xl leading-tight font-extrabold md:text-6xl"
      >
        A stack that stops you from <span class="gradient-text-cyan-green"
          >starting over</span
        >
      </h1>
      <p
        class="fade-in text-fg-secondary mx-auto max-w-2xl text-base md:text-lg"
      >
        ShockStack is a convention-first monorepo template. Every default is
        chosen so you can stop bikeshedding and ship.
      </p>
    </div>
  </section>

  <!-- stats -->
  <section class="reveal px-4 py-12 md:py-16">
    <div class="mx-auto max-w-5xl">
      <div class="stagger-in grid grid-cols-2 gap-6 md:grid-cols-4">
        <StatsCard value="14" label="Built-in themes" gradient="purple-pink" />
        <StatsCard value="50+" label="Components" gradient="cyan-green" />
        <StatsCard
          value="0"
          label="JS animation deps"
          gradient="orange-yellow"
        />
        <StatsCard value="MIT" label="License" gradient="pink-orange" />
      </div>
    </div>
  </section>

  <!-- principles -->
  <section class="reveal gradient-bg-subtle px-4 py-20 md:py-28">
    <div class="mx-auto max-w-5xl">
      <div class="mb-12">
        <p
          class="text-accent-purple mb-2 font-mono text-xs tracking-wider uppercase"
        >
          principles
        </p>
        <h2 class="mb-4 text-3xl font-bold md:text-4xl">
          The rules we refuse to <span class="gradient-text-purple-pink"
            >break</span
          >
        </h2>
        <p class="text-fg-secondary max-w-2xl text-lg">
          Every default traces back to one of these. If a feature fights them,
          it doesn't ship.
        </p>
      </div>

      <div class="stagger-in grid gap-4 md:grid-cols-2">
        {
          principles.map((p) => (
            <div class="principle-card">
              <h3 class="principle-title">{p.title}</h3>
              <p class="principle-body">{p.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- timeline -->
  <section class="reveal px-4 py-20 md:py-28">
    <div class="mx-auto max-w-3xl">
      <div class="mb-10">
        <p
          class="text-accent-orange mb-2 font-mono text-xs tracking-wider uppercase"
        >
          milestones
        </p>
        <h2 class="mb-4 text-3xl font-bold md:text-4xl">
          How we got <span class="gradient-text-orange-yellow">here</span>
        </h2>
      </div>

      <ol class="timeline">
        {
          timeline.map((entry) => (
            <li class="timeline-item">
              <span class={`timeline-dot timeline-dot-${entry.color}`} />
              <div class="timeline-body">
                <div class="timeline-meta">
                  <Badge color={entry.color} size="sm">
                    {entry.date}
                  </Badge>
                </div>
                <h3 class="timeline-title">{entry.title}</h3>
                <p class="timeline-text">{entry.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- team -->
  <section class="reveal gradient-bg-radial px-4 py-20 md:py-28">
    <div class="mx-auto max-w-5xl">
      <div class="mb-12 text-center">
        <p
          class="text-accent-pink mb-2 font-mono text-xs tracking-wider uppercase"
        >
          team
        </p>
        <h2 class="mb-4 text-3xl font-bold md:text-4xl">
          People behind <span class="gradient-text-pink-orange">the stack</span>
        </h2>
      </div>

      <div class="stagger-in grid gap-6 md:grid-cols-3">
        {
          team.map((member) => (
            <div class="team-card">
              <Avatar name={member.name} gradient={member.gradient} size="xl" />
              <h3 class="team-name">{member.name}</h3>
              <p class="team-role">{member.role}</p>
              <p class="team-bio">{member.bio}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- cta -->
  <section class="reveal px-4 py-20 md:py-24">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="mb-5 text-3xl font-bold md:text-4xl">
        Ready to <span class="gradient-text-animated">stop bikeshedding</span>?
      </h2>
      <p class="text-fg-secondary mb-8 text-lg">
        Clone the template, run one command, and ship.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href="/docs" class="about-cta about-cta-primary">Read the docs</a>
        <a href="/pricing" class="about-cta">See pricing</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .principle-card {
    padding: 1.5rem;
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-xl);
    background-color: var(--color-bg-secondary);
    transition:
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .principle-card:hover {
    border-color: var(--color-accent-purple);
    transform: translateY(-2px);
  }

  .principle-title {
    color: var(--color-fg-primary);
    font-size: 1.0625rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .principle-body {
    color: var(--color-fg-secondary);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
    position: relative;
  }

  .timeline::before {
    content: "";
    position: absolute;
    left: 0.4375rem;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 1px;
    background: linear-gradient(
      180deg,
      var(--color-accent-purple),
      var(--color-accent-pink),
      var(--color-accent-orange)
    );
    opacity: 0.4;
  }

  .timeline-item {
    position: relative;
    padding-left: 2rem;
    padding-bottom: 1.75rem;
  }

  .timeline-item:last-child {
    padding-bottom: 0;
  }

  .timeline-dot {
    position: absolute;
    left: 0;
    top: 0.375rem;
    width: 0.9375rem;
    height: 0.9375rem;
    border-radius: var(--radius-full);
    background-color: var(--color-bg-primary);
    border: 2px solid;
  }

  .timeline-dot-purple {
    border-color: var(--color-accent-purple);
  }
  .timeline-dot-pink {
    border-color: var(--color-accent-pink);
  }
  .timeline-dot-cyan {
    border-color: var(--color-accent-cyan);
  }
  .timeline-dot-green {
    border-color: var(--color-accent-green);
  }
  .timeline-dot-orange {
    border-color: var(--color-accent-orange);
  }

  .timeline-meta {
    margin-bottom: 0.5rem;
  }

  .timeline-title {
    color: var(--color-fg-primary);
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: 0.375rem;
  }

  .timeline-text {
    color: var(--color-fg-secondary);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .team-card {
    padding: 1.75rem;
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-xl);
    background-color: var(--color-bg-secondary);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    transition:
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .team-card:hover {
    border-color: var(--color-accent-pink);
    transform: translateY(-2px);
  }

  .team-name {
    color: var(--color-fg-primary);
    font-size: 1.0625rem;
    font-weight: 600;
    margin-top: 0.75rem;
  }

  .team-role {
    color: var(--color-accent-pink);
    font-size: 0.8125rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .team-bio {
    color: var(--color-fg-secondary);
    font-size: 0.875rem;
    line-height: 1.6;
    margin-top: 0.5rem;
  }

  .about-cta {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-lg);
    font-size: 0.875rem;
    font-weight: 600;
    border: 1px solid var(--color-border-default);
    color: var(--color-fg-primary);
    background-color: var(--color-bg-secondary);
    text-decoration: none;
    transition:
      border-color 0.15s ease,
      color 0.15s ease;
  }

  .about-cta:hover {
    border-color: var(--color-accent-purple);
    color: var(--color-accent-purple);
  }

  .about-cta-primary {
    border: none;
    color: var(--color-bg-primary);
    background: linear-gradient(
      135deg,
      var(--color-accent-purple),
      var(--color-accent-pink)
    );
  }

  .about-cta-primary:hover {
    color: var(--color-bg-primary);
    opacity: 0.9;
  }
</style>
