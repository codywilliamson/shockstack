{
  "name": "@shockstack/tokens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "tokens:extract": "node ../../node_modules/@google/design.md/dist/index.js export --format dtcg ../../docs/system/DESIGN.md > tokens/design-md.json",
    "build": "pnpm tokens:extract && tsx build.ts",
    "lint:design": "node ../../node_modules/@google/design.md/dist/index.js lint ../../docs/system/DESIGN.md"
  },
  "devDependencies": {
    "style-dictionary": "^5.5.0",
    "tsx": "^4.23.0"
  }
}
