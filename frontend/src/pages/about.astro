---
import BaseLayout from "../layouts/BaseLayout.astro";
import DemoBanner from "../components/content/DemoBanner.astro";
import AboutHero from "../components/about/AboutHero.astro";
import AboutStats from "../components/about/AboutStats.astro";
import PrinciplesSection from "../components/about/PrinciplesSection.astro";
import TimelineSection from "../components/about/TimelineSection.astro";
import TeamSection from "../components/about/TeamSection.astro";
import AboutCta from "../components/about/AboutCta.astro";

export const prerender = true;
---

<BaseLayout
  title="About — ShockStack"
  description="Why ShockStack exists, the team behind it, and the principles that guide every decision."
  fullWidth
>
  <DemoBanner
    label="Demo page"
    message="Team members and timeline dates are placeholders — swap in your own when adopting the template."
    href="/components"
    ctaLabel="View components"
  />
  <AboutHero />
  <AboutStats />
  <PrinciplesSection />
  <TimelineSection />
  <TeamSection />
  <AboutCta />
</BaseLayout>
