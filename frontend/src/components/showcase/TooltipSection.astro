---
import TooltipHover from "../ui/TooltipHover.vue";
---

<!-- tooltips -->
<section class="reveal px-4 py-20 md:py-28">
  <div class="mx-auto max-w-6xl">
    <div class="mb-12">
      <p
        class="text-accent-green mb-2 font-mono text-xs tracking-wider uppercase"
      >
        tooltips
      </p>
      <h2 class="mb-4 text-3xl font-bold md:text-4xl">
        Hover <span class="gradient-text-green-cyan">tooltips</span>
      </h2>
      <p class="text-fg-secondary max-w-2xl text-lg">
        Positioned on all four sides, portaled to body, respects motion
        preferences.
      </p>
    </div>

    <div class="tooltip-demo">
      <TooltipHover
        client:load
        content="Tooltip on top — the default position"
        side="top"
        triggerClass="tooltip-trigger-btn"
      >
        Top
      </TooltipHover>
      <TooltipHover
        client:load
        content="Tooltip on the right side"
        side="right"
        triggerClass="tooltip-trigger-btn"
      >
        Right
      </TooltipHover>
      <TooltipHover
        client:load
        content="Tooltip below the trigger"
        side="bottom"
        triggerClass="tooltip-trigger-btn"
      >
        Bottom
      </TooltipHover>
      <TooltipHover
        client:load
        content="Tooltip on the left side"
        side="left"
        triggerClass="tooltip-trigger-btn"
      >
        Left
      </TooltipHover>
    </div>
  </div>
</section>

<style>
  .tooltip-demo {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    padding: 3rem 1rem;
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-xl);
    background-color: var(--color-bg-secondary);
  }
</style>
