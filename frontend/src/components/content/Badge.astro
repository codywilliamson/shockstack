---
interface Props {
  color?:
    | "purple"
    | "pink"
    | "green"
    | "cyan"
    | "orange"
    | "red"
    | "yellow"
    | "neutral";
  variant?: "solid" | "subtle" | "outline";
  size?: "sm" | "md";
}

const { color = "purple", variant = "subtle", size = "md" } = Astro.props;
---

<span
  class:list={["badge", `badge-${color}`, `badge-${variant}`, `badge-${size}`]}
>
  <slot />
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--font-sans);
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.01em;
    border-radius: var(--radius-full);
    white-space: nowrap;
  }

  .badge-sm {
    font-size: 0.6875rem;
    padding: 0.1875rem 0.5rem;
  }

  .badge-md {
    font-size: 0.75rem;
    padding: 0.25rem 0.625rem;
  }

  /* subtle: tinted bg, full-color text */
  .badge-subtle.badge-purple {
    background-color: color-mix(
      in srgb,
      var(--color-accent-purple) 14%,
      transparent
    );
    color: var(--color-accent-purple);
  }
  .badge-subtle.badge-pink {
    background-color: color-mix(
      in srgb,
      var(--color-accent-pink) 14%,
      transparent
    );
    color: var(--color-accent-pink);
  }
  .badge-subtle.badge-green {
    background-color: color-mix(
      in srgb,
      var(--color-accent-green) 14%,
      transparent
    );
    color: var(--color-accent-green);
  }
  .badge-subtle.badge-cyan {
    background-color: color-mix(
      in srgb,
      var(--color-accent-cyan) 14%,
      transparent
    );
    color: var(--color-accent-cyan);
  }
  .badge-subtle.badge-orange {
    background-color: color-mix(
      in srgb,
      var(--color-accent-orange) 14%,
      transparent
    );
    color: var(--color-accent-orange);
  }
  .badge-subtle.badge-red {
    background-color: color-mix(
      in srgb,
      var(--color-accent-red) 14%,
      transparent
    );
    color: var(--color-accent-red);
  }
  .badge-subtle.badge-yellow {
    background-color: color-mix(
      in srgb,
      var(--color-accent-yellow) 14%,
      transparent
    );
    color: var(--color-accent-yellow);
  }
  .badge-subtle.badge-neutral {
    background-color: var(--color-bg-tertiary);
    color: var(--color-fg-secondary);
  }

  /* solid: full color bg, contrasting text */
  .badge-solid {
    color: var(--color-bg-primary);
  }
  .badge-solid.badge-purple {
    background-color: var(--color-accent-purple);
  }
  .badge-solid.badge-pink {
    background-color: var(--color-accent-pink);
  }
  .badge-solid.badge-green {
    background-color: var(--color-accent-green);
  }
  .badge-solid.badge-cyan {
    background-color: var(--color-accent-cyan);
  }
  .badge-solid.badge-orange {
    background-color: var(--color-accent-orange);
  }
  .badge-solid.badge-red {
    background-color: var(--color-accent-red);
  }
  .badge-solid.badge-yellow {
    background-color: var(--color-accent-yellow);
  }
  .badge-solid.badge-neutral {
    background-color: var(--color-fg-primary);
    color: var(--color-bg-primary);
  }

  /* outline: transparent bg, colored border + text */
  .badge-outline {
    background-color: transparent;
    border: 1px solid currentColor;
  }
  .badge-outline.badge-purple {
    color: var(--color-accent-purple);
  }
  .badge-outline.badge-pink {
    color: var(--color-accent-pink);
  }
  .badge-outline.badge-green {
    color: var(--color-accent-green);
  }
  .badge-outline.badge-cyan {
    color: var(--color-accent-cyan);
  }
  .badge-outline.badge-orange {
    color: var(--color-accent-orange);
  }
  .badge-outline.badge-red {
    color: var(--color-accent-red);
  }
  .badge-outline.badge-yellow {
    color: var(--color-accent-yellow);
  }
  .badge-outline.badge-neutral {
    color: var(--color-fg-secondary);
    border-color: var(--color-border-default);
  }
</style>
