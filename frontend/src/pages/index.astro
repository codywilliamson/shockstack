---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroShowcase from "../components/heroes/HeroShowcase.astro";
import FeatureGrid from "../components/content/FeatureGrid.astro";
import StackViz from "../components/content/StackViz.astro";
import UseCaseTeaser from "../components/content/UseCaseTeaser.astro";
import CodePreviewSection from "../components/content/CodePreviewSection.astro";
import AboutSection from "../components/content/AboutSection.astro";
import CtaSection from "../components/content/CtaSection.astro";

export const prerender = true;
---

<BaseLayout
  title="ShockStack — Convention-First Monorepo Template"
  description="Ship faster with Astro 5, Vue 3, Tailwind 4, and an optional .NET 10 backend. Batteries included."
  fullWidth
>
  <HeroShowcase />
  <FeatureGrid />
  <StackViz />
  <UseCaseTeaser />
  <CodePreviewSection />
  <AboutSection />
  <CtaSection />
</BaseLayout>
