---
import BaseLayout from "../layouts/BaseLayout.astro";
import GradientCardsSection from "../components/showcase/GradientCardsSection.astro";
import StatsSection from "../components/showcase/StatsSection.astro";
import TestimonialsSection from "../components/showcase/TestimonialsSection.astro";
import PricingSection from "../components/showcase/PricingSection.astro";
import BadgesSection from "../components/showcase/BadgesSection.astro";
import AlertsSection from "../components/showcase/AlertsSection.astro";
import KeyboardSection from "../components/showcase/KeyboardSection.astro";
import AvatarsSection from "../components/showcase/AvatarsSection.astro";
import AccordionSection from "../components/showcase/AccordionSection.astro";
import TooltipSection from "../components/showcase/TooltipSection.astro";
import ProgressSection from "../components/showcase/ProgressSection.astro";
import SkeletonSection from "../components/showcase/SkeletonSection.astro";
import DemoBannerSection from "../components/showcase/DemoBannerSection.astro";
import GradientTextSection from "../components/showcase/GradientTextSection.astro";
import GradientBgSection from "../components/showcase/GradientBgSection.astro";

export const prerender = true;
---

<BaseLayout
  title="Components — ShockStack"
  description="Design component showcase built with ShockStack design tokens."
  fullWidth
>
  <!-- hero with mesh gradient bg -->
  <section
    class="gradient-bg-mesh relative overflow-hidden px-4 pt-20 pb-16 md:pt-28 md:pb-24"
  >
    <div class="relative mx-auto max-w-5xl text-center">
      <p
        class="fade-in text-accent-cyan mb-4 font-mono text-sm font-medium tracking-wider uppercase"
      >
        design system
      </p>
      <h1
        class="fade-in mb-6 text-5xl leading-tight font-extrabold md:text-7xl"
      >
        Token-powered
        <span class="gradient-text-purple-pink">components</span>
      </h1>
      <p
        class="fade-in text-fg-secondary mx-auto mb-10 max-w-2xl text-lg md:text-xl"
      >
        Every component adapts to all 14 themes automatically. Built with CSS
        custom properties, zero JavaScript animation dependencies.
      </p>
    </div>
  </section>

  <GradientCardsSection />
  <StatsSection />
  <TestimonialsSection />
  <PricingSection />
  <BadgesSection />
  <AlertsSection />
  <KeyboardSection />
  <AvatarsSection />
  <AccordionSection />
  <TooltipSection />
  <ProgressSection />
  <SkeletonSection />
  <DemoBannerSection />
  <GradientTextSection />
  <GradientBgSection />
</BaseLayout>
