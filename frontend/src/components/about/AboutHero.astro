---
import Badge from "../content/Badge.astro";
---

<!-- hero -->
<section
  class="gradient-bg-mesh relative overflow-hidden px-4 pt-20 pb-16 md:pt-28 md:pb-24"
>
  <div class="relative mx-auto max-w-4xl text-center">
    <div class="fade-in mb-4 flex justify-center">
      <Badge color="cyan" variant="subtle">Our story</Badge>
    </div>
    <h1 class="fade-in mb-5 text-4xl leading-tight font-extrabold md:text-6xl">
      A stack that stops you from <span class="gradient-text-cyan-green"
        >starting over</span
      >
    </h1>
    <p class="fade-in text-fg-secondary mx-auto max-w-2xl text-base md:text-lg">
      ShockStack is a convention-first monorepo template. Every default is
      chosen so you can stop bikeshedding and ship.
    </p>
  </div>
</section>
