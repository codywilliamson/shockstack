---
import UseCaseIcon from "./UseCaseIcon.astro";
import { stackOptions, type StackUseCase } from "../../lib/use-cases";

interface Props {
  useCase: StackUseCase;
  compact?: boolean;
  detailed?: boolean;
}

const { useCase, compact = false, detailed = false } = Astro.props;
const includeOptions = useCase.include.map((id) => stackOptions[id]);
const skipOptions = useCase.skip.map((id) => stackOptions[id]);
const outcomes = compact ? useCase.outcomes.slice(0, 2) : useCase.outcomes;
---

<article
  id={`use-case-${useCase.id}`}
  class:list={[
    "bg-bg-secondary border-border-default hover-lift rounded-xl border p-5",
  ]}
>
  <header class="mb-3 flex items-start gap-3">
    <UseCaseIcon id={useCase.id} />
    <div class="min-w-0 flex-1">
      <h3 class="text-fg-primary text-lg font-semibold">{useCase.title}</h3>
      <p class="text-fg-secondary mt-1 text-sm leading-relaxed">
        {useCase.summary}
      </p>
    </div>
  </header>

  {
    detailed && (
      <div class="border-border-muted mb-4 rounded-lg border-l-2 pl-3">
        <p class="text-fg-muted mb-1 font-mono text-[11px] tracking-wider uppercase">
          Best for
        </p>
        <p class="text-fg-secondary text-sm leading-relaxed">
          {useCase.bestFor}
        </p>
      </div>
    )
  }

  <ul class="text-fg-secondary mb-4 list-disc space-y-1 pl-5 text-sm">
    {outcomes.map((outcome) => <li>{outcome}</li>)}
  </ul>

  <div class="space-y-3">
    <div>
      <p
        class="text-fg-muted mb-2 font-mono text-[11px] tracking-wider uppercase"
      >
        Include
      </p>
      <div class="flex flex-wrap gap-2">
        {
          includeOptions.map((option) => (
            <span class="bg-bg-tertiary border-border-default rounded-full border px-2.5 py-1 text-xs">
              {option.label}
            </span>
          ))
        }
      </div>
    </div>

    {
      !compact && skipOptions.length > 0 && (
        <div>
          <p class="text-fg-muted mb-2 font-mono text-[11px] tracking-wider uppercase">
            Can Skip
          </p>
          <div class="flex flex-wrap gap-2">
            {skipOptions.map((option) => (
              <span class="border-border-muted text-fg-muted rounded-full border px-2.5 py-1 text-xs">
                {option.label}
              </span>
            ))}
          </div>
        </div>
      )
    }
  </div>

  {
    detailed && (
      <div class="border-border-muted mt-5 space-y-3 border-t pt-4">
        {useCase.examples.length > 0 && (
          <div>
            <p class="text-fg-muted mb-1 font-mono text-[11px] tracking-wider uppercase">
              Examples
            </p>
            <p class="text-fg-secondary text-sm">
              {useCase.examples.join(" · ")}
            </p>
          </div>
        )}
        {useCase.tradeoffs.length > 0 && (
          <div>
            <p class="text-fg-muted mb-1 font-mono text-[11px] tracking-wider uppercase">
              Trade-offs
            </p>
            <ul class="text-fg-secondary list-disc space-y-1 pl-5 text-sm">
              {useCase.tradeoffs.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        )}
        <a
          href={useCase.nextSteps.href}
          class="text-accent-purple hover:text-accent-pink inline-flex items-center gap-1 text-sm font-medium transition-colors"
        >
          {useCase.nextSteps.label}
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    )
  }
</article>
